{
  "project_name": "BluBridge AI Consulting Contact Form",
  "route": "/ai-consulting",
  "design_system": {
    "theme": "light",
    "primary_color": "#2b4c8c",
    "background_color": "#f0f2fa",
    "text_color": "#0a102c",
    "muted_color": "#7d8293",
    "border_color": "#dfe2eb",
    "error_color": "#b3293a",
    "font_family": "Geist, sans-serif",
    "mono_font": "IBM Plex Mono, monospace"
  },
  "typography": {
    "eyebrow": "text-xs font-mono uppercase tracking-wider color-#434b65",
    "heading": "text-4xl font-semibold color-#0a102c",
    "subtitle": "text-base color-#525767",
    "field_label": "text-xs font-medium color-#0a102c",
    "helper_text": "text-xs color-#7d8293"
  },
  "layout": {
    "container_max_width": "970px",
    "desktop_columns": 2,
    "mobile_columns": 1,
    "group_spacing": "32px",
    "field_spacing": "20px"
  },
  "form_structure": {
    "steps": [
      "Your Details",
      "Project Details",
      "Review"
    ],
    "section_title": "Project Details",
    "subtitle": "Tell us about your requirement so we can understand how to help.",
    "fields": [
      {
        "id": "services",
        "label": "What can BluBridge help you with? *",
        "helper": "Select all that apply.",
        "type": "checkbox_grid",
        "columns_desktop": 2,
        "options": [
          "AI Consulting & Technical Advisory",
          "Custom AI & Model Development",
          "Generative AI, LLM & RAG Systems",
          "AI Agents & Automation",
          "Model Training & Fine-Tuning",
          "GPU & AI Systems Optimisation",
          "Deployment & Integration",
          "Maintenance & Support",
          "Not sure — I need guidance",
          "Other"
        ],
        "exclusive_option": "Not sure — I need guidance",
        "conditional_field": {
          "trigger_option": "Other",
          "id": "other_requirement",
          "label": "Please specify your requirement *",
          "placeholder": "Briefly specify your requirement",
          "type": "text"
        }
      },
      {
        "id": "requirement_details",
        "label": "Tell us about your requirement *",
        "type": "textarea",
        "placeholder": "What problem are you trying to solve? Briefly describe what you would like to build or improve, the expected outcome and any existing systems involved."
      },
      {
        "id": "project_stage",
        "label": "What is the current stage of your project? *",
        "type": "dropdown",
        "placeholder": "Select your project stage",
        "options": [
          "Exploring options",
          "Requirements defined",
          "Planning a proof of concept or pilot",
          "Development in progress",
          "Improving an existing system",
          "Ready for deployment",
          "Other"
        ]
      },
      {
        "id": "start_timeline",
        "label": "When would you like to start? *",
        "type": "dropdown",
        "placeholder": "Select your expected start timeline",
        "options": [
          "Within 30 days",
          "1–3 months",
          "3–6 months",
          "More than 6 months",
          "No fixed start date yet"
        ]
      },
      {
        "id": "budget_type",
        "label": "How would you like to specify your budget? *",
        "type": "radio_group",
        "helper": "Select whether your estimate covers the project or initial phase, or a recurring monthly engagement.",
        "options": [
          "Total project / initial engagement budget",
          "Monthly budget for an ongoing engagement"
        ]
      },
      {
        "id": "estimated_budget",
        "type": "dynamic_dropdown",
        "cases": {
          "Total project / initial engagement budget": {
            "label": "Estimated Project Budget (USD) *",
            "options": [
              "Below $10,000",
              "$10,000–$24,999",
              "$25,000–$49,999",
              "$50,000–$99,999",
              "$100,000–$249,999",
              "$250,000 or more",
              "Budget not yet defined"
            ]
          },
          "Monthly budget for an ongoing engagement": {
            "label": "Estimated Monthly Budget (USD) *",
            "options": [
              "Below $5,000 per month",
              "$5,000–$9,999 per month",
              "$10,000–$24,999 per month",
              "$25,000–$49,999 per month",
              "$50,000 or more per month",
              "Budget not yet defined"
            ]
          }
        }
      },
      {
        "id": "budget_status",
        "label": "What is the current status of this budget? *",
        "type": "dropdown",
        "placeholder": "Select budget status",
        "options": [
          "Budget approved and available",
          "Budget proposed — approval pending",
          "Need a scoped proposal to secure approval",
          "No budget available currently",
          "I do not know the budget status yet"
        ]
      }
    ]
  },
  "actions": {
    "back_button": "Back",
    "primary_button": "Review & Continue"
  },
  "validation_rules": {
    "inline_messages": true,
    "error_style": "subtle red border (#b3293a) and text below field"
  },
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": [
    "Preserve existing headers, footers, typography and brand color schemes.",
    "Ensure all interactive elements have explicit data-testid attributes.",
    "Do not add heavy gradients, glassmorphism, or dark modes unless specified.",
    "Ensure keyboard accessibility and visible focus rings on interactive elements."
  ]
}